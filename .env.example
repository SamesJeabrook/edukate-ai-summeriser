# Local configuration for Edukate Progress Summariser
# Copy this file to .env and replace the placeholder API key.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Model used by the OpenAI provider.
EDUKATE_MODEL=gpt-4o-mini

# Input safety limits.
EDUKATE_MAX_LEARNERS=500
EDUKATE_MAX_ACTIVITY_RECORDS=5000

# Optional rule configuration paths.
EDUKATE_EMPLOYER_RULES=
EDUKATE_COHORT_RULES=
